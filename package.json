{
  "name": "pms-peiw",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PMS - PEIW: procurement plan dashboard for oil & gas projects",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
